      "parameters": {
        "jsCode": "// Базовые элементы JS: let/const, массив, объект, цикл for, if/else\n\nconst userName = \"Коток\";\nlet counter = 0;\n\n// Массив\nconst numbers = [1, 2, 3, 4, 5];\nconst doubled = [];\n\n// Цикл for\nfor (let i = 0; i < numbers.length; i++) {\n  doubled.push(numbers[i] * 2);\n  counter++;\n}\n\n// Условие if/else\nlet status;\nif (counter > 3) {\n  status = \"большой массив\";\n} else {\n  status = \"маленький массив\";\n}\n\n// Объект-результат\nconst result = {\n  user: userName,\n  status: status,\n  doubled: doubled,\n  count: counter\n};\n\n// Возвращаем объект с полем payload\nreturn [{\n  json: {\n    payload: result\n  }\n}];"
      },
