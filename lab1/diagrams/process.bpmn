  <bpmn:process id="Process_HotelBooking" name="Бронирование номера в отеле" isExecutable="false">
    <bpmn:startEvent id="Start" name="Заявка получена от клиента">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Принять заявку">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Проверить наличие свободных номеров">
      <bpmn:incoming>Flow_0yl0rkc</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="XOR1" name="Номер свободен?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3" name="Предложить альтернативу">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_16fkh0n</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End1" name="Бронирование отклонено">
      <bpmn:incoming>Flow_0zjc9zm</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T4" name="Рассчитать стоимость проживания">
