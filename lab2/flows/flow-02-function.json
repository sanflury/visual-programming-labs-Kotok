    {
        "id": "5469dd9185599d08",
        "type": "function",
        "z": "2d1435e62dfe5990",
        "name": "Обработка",
        "func": "// Принимаем число, обрабатываем, возвращаем объект\nconst input = msg.payload;\nconst numbers = [1, 2, 3, 4, 5];\nconst doubled = [];\n\n// Цикл for: удваиваем каждое число\nfor (let i = 0; i < numbers.length; i++) {\n    doubled.push(numbers[i] * 2);\n}\n\n// Условие if/else: большое число или маленькое\nlet status;\nif (input > 10) {\n    status = \"большое\";\n} else {\n    status = \"маленькое\";\n}\n\n// Формируем объект-результат\nconst result = {\n    original: input,\n    status: status,\n    doubled: doubled,\n    user: \"Коток\"\n};\n\nmsg.payload = result;\nreturn msg;",
