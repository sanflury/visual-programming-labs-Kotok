    {
        "id": "f98e4a60047faed5",
        "type": "function",
        "z": "aca1d96b781a9e7e",
        "name": "items-logic",
        "func": "// Получаем query-параметр id\nconst id = msg.req.query.id;\n\n// 400 — если id не передан\nif (!id) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Bad Request\",\n        message: \"Параметр id обязателен\"\n    };\n    return msg;\n}\n\n// 404 — если id не 1 и не 2\nif (id !== \"1\" && id !== \"2\") {\n    msg.statusCode = 404;\n    msg.payload = {\n        error: \"Not Found\",\n        message: \"Элемент с id=\" + id + \" не найден\"\n    };\n    return msg;\n}\n\n// 200 — успех\nmsg.statusCode = 200;\nmsg.payload = {\n    id: id,\n    name: \"Номер \" + id,\n    price: id === \"1\" ? 5000 : 8000,\n    currency: \"BYN\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 270,
        "y": 460,
