        "func": "// Читаем счётчик из flow context (если нет — начинаем с 0)\nlet counter = flow.get(\"myCounter\") || 0;\n\n// Увеличиваем на 1\ncounter = counter + 1;\n\n// Сохраняем обратно в flow context\nflow.set(\"myCounter\", counter);\n\n// Формируем ответ\nmsg.payload = {\n    message: \"Счётчик увеличен\",\n    counter: counter,\n    student: \"Коток\",\n    group: \"УИР-241\"\n};\n\nreturn msg;",
